# ============================================================
# Secretary — environment variables
# Copy to .env.local and fill in real values.
# .env.example is committed (no secrets); .env.local never is.
# ============================================================

# ---------- OpenAI (REQUIRED — voice + extraction) ----------
# Get it: https://platform.openai.com/api-keys  (create a project key)
# Used server-side only: minting Realtime ephemeral client secrets,
# dictation transcription, extraction jobs, layout generation.
# NEVER expose this to the client / never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-proj-...

# Realtime models (defaults per spec; override only if OpenAI renames them)
REALTIME_MODEL_DEFAULT=gpt-realtime-2.1
REALTIME_MODEL_MINI=gpt-realtime-2.1-mini

# ---------- Better Auth (REQUIRED) ----------
# Secret: generate with `openssl rand -base64 32` — signs session cookies/tokens.
BETTER_AUTH_SECRET=
# Base URL of the app (auth callbacks resolve against this)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database (REQUIRED) ----------
# Local dev: Docker Postgres, e.g.
#   docker run -d --name secretary-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=secretary -p 5432:5432 postgres:16
# Production: paste the connection string from Neon or Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secretary

# ---------- Google sign-in (required for "Sign in with Google") ----------
# Get them: https://console.cloud.google.com/apis/credentials
#   → Create OAuth client ID → Web application
#   → Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#     (add the production URL equivalent when you deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Apple sign-in (optional for local dev; needed before iOS) ----------
# Requires Apple Developer Program membership ($99/yr).
# Get them: https://developer.apple.com/account → Certificates, Identifiers & Profiles
#   1. Create an App ID, then a Services ID (this is APPLE_CLIENT_ID)
#   2. Enable "Sign in with Apple" on the Services ID; set return URL:
#      https://<your-domain>/api/auth/callback/apple  (Apple requires https — use prod
#      or a tunnel like ngrok; it won't work on plain http://localhost)
#   3. Create a Sign in with Apple private key (.p8). APPLE_CLIENT_SECRET is a JWT
#      you generate from that key (Better Auth docs show the script; regenerate ~6 monthly).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---------- Email delivery (required for verify-email + forgot-password) ----------
# Get it: https://resend.com → API Keys (free tier is fine for dev).
# EMAIL_FROM must be on a domain you've verified in Resend
# (onboarding@resend.dev works for testing to your own address).
RESEND_API_KEY=
EMAIL_FROM="Secretary <onboarding@resend.dev>"

# ---------- Remote access (optional) ----------
# Extra origins allowed to reach the app (auth CSRF + dev assets). Origins are
# matched exactly, port included.
# - Phone testing (tailnet or public via Tailscale Funnel — both serve the
#   same origin): `npm run dev:public` publishes
#   https://<machine>.<tailnet>.ts.net:8443 — list that URL here.
# - cloudflared fallback: each `npm run tunnel:cf` prints a random
#   https://<something>.trycloudflare.com URL — append it here for that run.
TRUSTED_ORIGINS=

# ---------- Voice quotas & kill switch ----------
VOICE_SESSIONS_PER_DAY=30
VOICE_MAX_CONCURRENT=1
VOICE_DISABLED=false
# Dictation transcription (/api/transcribe) has its own per-user limit
TRANSCRIBE_REQUESTS_PER_DAY=300

# ---------- Text-side models (Responses API) ----------
# Flagship for secretary chat/extraction; override if OpenAI ships newer.
TEXT_MODEL=gpt-5.5
# Dictation transcription model for /api/transcribe
TRANSCRIBE_MODEL=gpt-4o-transcribe
